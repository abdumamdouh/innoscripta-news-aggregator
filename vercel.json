{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:source/:path*", "destination": "/api/proxy?__source=:source&__path=:path*" },
    { "source": "/((?!api/.*).*)", "destination": "/index.html" }
  ]
}
