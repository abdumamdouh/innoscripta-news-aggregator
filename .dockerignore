# The build-irrelevant half of .gitignore, plus the things git tracks but the image never needs.
# Everything here is either rebuilt inside the image, or must not enter the build context at all.

# Secrets. No .env file has any business in the context: the keys arrive at runtime.
.env
.env.*

node_modules
dist
dist-ssr
coverage
test-results
playwright-report
.playwright-mcp

.git
.github
.claude
.implement-feature-loop
e2e
*.log
.DS_Store
