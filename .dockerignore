# Mirrors .gitignore: the build context is source + package manifests, nothing else.
# `dist` matters most — a stale local build must never be copied over the one npm run build
# produces inside the image.
node_modules
dist
dist-ssr
coverage
playwright-report
test-results
.playwright-mcp
*.log

# Secrets never enter the build context. Keys are runtime-only (see docker-compose.yml).
.env
.env.*
!.env.example

.git
.github
.vscode
.idea
.DS_Store

# Not e2e/ — tsconfig.node.json references it and `npm run build` runs `tsc -b`.
Dockerfile
.dockerignore
