# Copy to .env.local for development. Never commit real keys.
#
# In dev these are read by vite.config.ts's proxy; in the Docker image they are read
# by nginx (docker/nginx.conf.template). Either way the key is attached server-side and
# never reaches the browser bundle — `grep -r VITE_ dist/` must come back empty.
#
# NewsAPI.org      https://newsapi.org/register        (free tier: 100 req/day, localhost only)
# The Guardian     https://open-platform.theguardian.com/access/
# New York Times   https://developer.nytimes.com/get-started   (Article Search API)
# BBC News         no key — public RSS at feeds.bbci.co.uk

NEWSAPI_KEY=
GUARDIAN_KEY=
NYT_KEY=
